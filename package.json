{
  "name": "naval-wargame",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node tests/run-regression.mjs",
    "test:qq-bridge": "node tests/qq-bridge-smoke.mjs",
    "test:bilateral-objective": "npx esbuild tests/bilateral-objective-sim.ts --bundle --platform=node --format=esm --outfile=dist/bilateral-objective-sim.mjs && node dist/bilateral-objective-sim.mjs",
    "test:diagnose": "node scripts/build-diagnostics.mjs",
    "test:web-smoke": "node tests/web-smoke.mjs",
    "test:multiplayer-sync": "node tests/multiplayer-server-smoke.mjs",
    "qq:mock": "node scripts/onebot-mock-server.mjs",
    "qq:check": "node scripts/qq-bridge-check.mjs",
    "multiplayer:qq": "node scripts/multiplayer-server.mjs --config config/qq-bridge.local.json",
    "multiplayer:server": "node scripts/multiplayer-server.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/three": "^0.184.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.1",
    "three": "^0.184.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "ws": "^8.21.0"
  }
}
